# ==========================================
# Git Ignore for PDF-app
# ==========================================

# Compressed Archives & Bundles
backend.zip
*.zip
*.tar.gz
*.rar
*.7z

# Java / Gradle / Crash Logs & Replays
*.log
**/*.log
hs_err_pid*
replay_pid*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node / Backend
node_modules/
backend/node_modules/
package-lock.json.bak
.env
.env.*
backend/.env
backend/.env.*

# Flutter / Dart / Frontend Build Artifacts
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.pub-cache/
frontend/.pub/
frontend/build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/

# Android Specific
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/app/debug/
frontend/android/app/profile/
frontend/android/app/release/
.gradle/
local.properties
*.keystore
*.jks

# iOS Specific
frontend/ios/Flutter/.last_build_id
frontend/ios/Pods/
frontend/.symlinks/

# IDE & Editor Specific
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
